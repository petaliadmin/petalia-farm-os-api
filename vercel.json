{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "version": 2,
  "builds": [
    {
      "src": "api/index.ts",
      "use": "@vercel/node",
      "config": {
        "includeFiles": [
          "dist/**"
        ],
        "maxDuration": 60
      }
    }
  ],
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/api"
    }
  ],
  "crons": [
    {
      "path": "/api/internal/cron/NotificationsService.purgeOldNotifications",
      "schedule": "0 0 * * *"
    },
    {
      "path": "/api/internal/cron/IdempotencyService.purgeExpired",
      "schedule": "0 3 * * *"
    }
  ]
}
